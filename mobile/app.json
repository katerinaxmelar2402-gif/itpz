{
  "expo": {
    "name": "Итопиз",
    "slug": "mobile",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/itopiz-icon-1024.png",
    "userInterfaceStyle": "light",
    "scheme": "itpz",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "icon": "./assets/itopiz-icon-1024.png"
    },
    "web": {
      "favicon": "./assets/itopiz-icon-512.png"
    }
  }
}
