# Добавь эти строки в server/.env, сохранив существующие настройки базы.
# Authorization Key из кабинета, без слова Basic. Не Client Secret и не Access Token.
GIGACHAT_AUTH_KEY=PASTE_AUTHORIZATION_KEY_HERE
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
